<?xml version="1.0" encoding="utf-8"?>
<!-- auto_ink: the dimmed second line of a popup row over a light wallpaper (pill_text_dim keeps it at 55%
     white), so the status stays quieter than the title and still reads on a bright backdrop. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#B3111111" />
    <item android:color="#B3000000" />
</selector>
