<?xml version="1.0" encoding="utf-8"?>
<!-- Hebrew screensaver: the huge time centred on the screen's bottom band, RTL day and date under it
     (LTR numerals), with DepthLayerView putting the wallpaper in front of the time's lower edge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- The glow is its background; clock_wallpaper puts the picture in it, cropped like Home's. -->
    <ImageView
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layoutDirection="rtl"
        android:gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/dreamClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFFFF"
            android:textSize="160sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="-0.03"
            android:includeFontPadding="false" />

        <TextClock
            android:id="@+id/dreamDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textDirection="rtl"
            android:gravity="center"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#E6FFFFFF"
            android:textSize="30sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.02"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- The same picture again, fading in over the time from just below its middle: the picture is
         in front (ClockScene sets the two lines from where the time stands, and stops at it, so the
         day and date below stay whole). -->
    <com.gathin.tvhome.DepthLayerView
        android:id="@+id/dreamDepth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />
</FrameLayout>
