<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): a lock-screen clock — date over a huge time at the top left — with
     DepthLayerView putting the wallpaper's lower half in front of the clock's lower edge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- The glow is its background; clock_wallpaper puts the picture in it, cropped like Home's. -->
    <ImageView
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#E6FFFFFF"
            android:textSize="30sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.02"
            android:includeFontPadding="false" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFFFF"
            android:textSize="160sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="-0.03"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- The same picture again, fading in over the clock from just below its middle: the picture is
         in front (ClockScene sets the two lines from where the clock stands). -->
    <com.gathin.tvhome.DepthLayerView
        android:id="@+id/dreamDepth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />
</FrameLayout>
